<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#071b17" />
    <meta name="description" content="BBK Caps - Islamic caps from Sunni Brothers with online ordering, QR payment, order tracking, and retailer support." />
    <title>BBK Caps | Premium Islamic Caps</title>
    <style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap');
:root{--bg:#061512;--card:#0d241f;--gold:#f7c767;--mint:#65e6b8;--text:#f8fff9;--muted:#adc6bd;--line:rgba(255,255,255,.12)}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,system-ui;background:radial-gradient(circle at 20% 0%,#164b3f 0,#061512 35%,#020706 100%);color:var(--text)}a{color:inherit;text-decoration:none}button,input,textarea,select{font:inherit}header{position:sticky;top:0;z-index:10;background:rgba(6,21,18,.78);backdrop-filter:blur(18px);border-bottom:1px solid var(--line)}nav{max-width:1180px;margin:auto;display:flex;align-items:center;justify-content:space-between;padding:16px 20px}.logo{display:flex;align-items:center;gap:12px}.logo-mark{width:54px;height:54px;border-radius:18px;background:linear-gradient(145deg,var(--gold),#fff2ba);color:#073127;display:grid;place-items:center;position:relative;box-shadow:0 0 35px rgba(247,199,103,.38)}.logo-mark span{position:absolute;font-weight:800;font-size:15px;bottom:8px}.logo strong{display:block;font-size:22px}.logo small{color:var(--muted)}.links{display:flex;align-items:center;gap:18px;text-transform:capitalize}.pill,.btn,button{border:0;border-radius:999px;padding:12px 18px;background:linear-gradient(135deg,var(--mint),#d8fff0);color:#08241e;font-weight:800;display:inline-flex;align-items:center;gap:8px;cursor:pointer}.menu-btn{display:none}.hero{max-width:1180px;margin:0 auto;padding:90px 20px 50px;display:grid;grid-template-columns:1.18fr .82fr;gap:45px;position:relative}.glow{position:absolute;border-radius:999px;filter:blur(20px);opacity:.45;animation:float 5s ease-in-out infinite}.one{width:170px;height:170px;background:var(--mint);right:20%;top:110px}.two{width:120px;height:120px;background:var(--gold);left:2%;bottom:0;animation-delay:1s}@keyframes float{50%{transform:translateY(-25px)}}.eyebrow{color:var(--gold);font-weight:800;display:inline-flex;gap:8px;align-items:center}.hero h1{font-size:clamp(42px,7vw,82px);line-height:.95;margin:18px 0}.hero p,.section p{color:var(--muted);font-size:18px;line-height:1.7}.hero-actions{display:flex;gap:14px;flex-wrap:wrap}.ghost{background:rgba(255,255,255,.08);color:var(--text);border:1px solid var(--line)}.hero-card,.panel,.product,.review,.stat{background:linear-gradient(160deg,rgba(255,255,255,.12),rgba(255,255,255,.04));border:1px solid var(--line);border-radius:30px;box-shadow:0 20px 70px rgba(0,0,0,.32)}.hero-card{padding:34px;min-height:410px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center}.dome{font-size:82px;width:190px;height:190px;border-radius:50% 50% 18px 18px;background:radial-gradient(circle,var(--gold),#a8731e);display:grid;place-items:center;box-shadow:0 0 50px rgba(247,199,103,.35)}.price{font-size:42px;font-weight:900;color:var(--mint)}.card-row{margin-top:20px;color:var(--gold);display:flex;gap:8px}.stats,.section{max-width:1180px;margin:0 auto;padding:40px 20px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.stat{padding:22px}.stat svg{color:var(--gold)}.stat strong{display:block;font-size:30px}.stat span{color:var(--muted)}.section-title{text-align:center;margin-bottom:28px}.section-title span{color:var(--gold);font-weight:800}.section-title h2,.section h2{font-size:clamp(30px,4vw,52px);margin:8px 0}.product-grid,.review-grid,.admin-grid,.contact-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.product{padding:24px;position:relative;overflow:hidden}.product:before{content:"";position:absolute;inset:auto -40px -70px auto;width:170px;height:170px;background:rgba(101,230,184,.16);border-radius:50%}.badge{color:#06221d;background:var(--gold);border-radius:999px;padding:7px 12px;display:inline-block;font-weight:800}.product-art{font-size:70px;margin:20px 0}.product h3{font-size:24px}.meta,.buy,.cart div,.order{display:flex;justify-content:space-between;gap:12px;align-items:center}.meta span{border:1px solid var(--line);border-radius:999px;padding:7px 10px;color:var(--muted)}.buy strong{font-size:28px;color:var(--mint)}.checkout,.split,.share-box{display:grid;grid-template-columns:1fr 1fr;gap:24px}.cart,.qr,form,.link-card{background:rgba(255,255,255,.06);border:1px solid var(--line);border-radius:24px;padding:22px}.qr{display:inline-block;background:white;color:#08241e;text-align:center;margin-top:14px}form,.link-card{display:grid;gap:12px}input,textarea,select{width:100%;border:1px solid var(--line);background:rgba(0,0,0,.22);color:var(--text);border-radius:16px;padding:14px}textarea{min-height:100px}.search{display:flex;align-items:center;gap:10px;background:rgba(255,255,255,.06);border-radius:18px;padding:8px 12px}.search input{border:0;background:transparent}.panel{padding:24px}.retailer{text-align:center}.contact-cards a{padding:22px;border:1px solid var(--line);border-radius:22px;background:rgba(255,255,255,.07);display:flex;align-items:center;justify-content:center;gap:10px;font-weight:800}.review{padding:24px}.stars{color:var(--gold);display:flex;gap:3px}.review-form{grid-template-columns:1fr 100px 1fr auto;margin-top:20px}.admin-grid{grid-template-columns:1fr 1.2fr 1fr}.panel h3{display:flex;align-items:center;gap:8px}.order{border-top:1px solid var(--line);padding:12px 0;flex-wrap:wrap}.order button{padding:8px 10px;background:#ffdddf}footer{margin-top:50px;border-top:1px solid var(--line);padding:30px 20px;display:flex;justify-content:center;gap:28px;align-items:center;color:var(--muted);flex-wrap:wrap}footer p{display:flex;gap:8px;align-items:center}@media(max-width:860px){.menu-btn{display:inline-flex}.links{display:none;position:absolute;left:16px;right:16px;top:82px;background:#09211c;border:1px solid var(--line);border-radius:22px;padding:18px;flex-direction:column}.links.open{display:flex}.hero,.checkout,.split,.share-box,.stats,.product-grid,.review-grid,.admin-grid,.contact-cards{grid-template-columns:1fr}.hero{padding-top:50px}.review-form{grid-template-columns:1fr}.hero-card{min-height:320px}.dome{width:140px;height:140px;font-size:58px}}

    </style>
  </head>
  <body>
    <div id="root"></div>
    <script>
const CONTACT={phone:'9155278386',email:'bbkcapsweb@gamil.com',youtube:'https://youtube.com/@sunnibrothers786?si=-n_uXQ_oD4mYibYi',upi:'9155278386@upi'};
const seed=[{id:'classic-white',name:'Classic White Prayer Cap',price:99,stock:84,category:'Daily Wear',badge:'Best Seller',color:'Ivory White',image:'🕌',description:'Soft breathable cotton cap for namaz, madrasa, and daily sunnah style.'},{id:'embroidered-black',name:'Black Embroidered Topi',price:149,stock:52,category:'Embroidery',badge:'Premium',color:'Noor Black',image:'☪️',description:'Elegant black Islamic cap with subtle geometric embroidery and firm fit.'},{id:'green-noor',name:'Green Noor Cap',price:129,stock:65,category:'Festival',badge:'New',color:'Emerald',image:'✨',description:'Modern green cap for Jummah, Eid, and gifting with premium stitching.'},{id:'kids-soft',name:'Kids Soft Islamic Cap',price:79,stock:110,category:'Kids',badge:'Low Price',color:'Pearl',image:'🌙',description:'Comfortable lightweight topi for children with durable washable fabric.'}];
let products=load('bbk-products',seed),orders=load('bbk-orders',[]),reviews=load('bbk-reviews',[{name:'Amaan Raza',rating:5,text:'Quality is better than local market and price is very good.'},{name:'Faizan Qadri',rating:5,text:'Fast response on WhatsApp and perfect fitting caps for our shop.'},{name:'Retail Partner',rating:4,text:'Bulk order packaging was neat. Recommended for retailers.'}]),cart=[];
function load(k,f){try{return JSON.parse(localStorage.getItem(k))||f}catch{return f}}function save(k,v){localStorage.setItem(k,JSON.stringify(v))}function id(){return`BBK-${Date.now().toString().slice(-6)}-${Math.floor(100+Math.random()*900)}`}function total(){return cart.reduce((s,i)=>s+i.price*i.qty,0)}function icon(x){return`<span class="ico">${x}</span>`}
function render(){document.querySelector('#root').innerHTML=`<header><nav><a class="logo" href="#"><div class="logo-mark">☪<span>ب</span></div><div><strong>BBK Caps</strong><small>Sunni Brothers Store</small></div></a><button class="menu-btn" id="menu">☰</button><div class="links" id="links"><a href="#products">products</a><a href="#track">track</a><a href="#retailer">retailer</a><a href="#reviews">reviews</a><a href="#admin">admin</a><a class="pill" href="tel:${CONTACT.phone}">☎ Call now</a></div></nav></header><main>${hero()}${stats()}${shareLink()}${productSection()}${checkout()}${tracking()}${retailer()}${reviewSection()}${admin()}</main><footer>${logo()}<p>📍 Serving online across India • ✅ Quality checked caps</p></footer>`;bind()}
function logo(){return`<div class="logo"><div class="logo-mark">☪<span>ب</span></div><div><strong>BBK Caps</strong><small>Sunni Brothers Store</small></div></div>`}
function hero(){return`<section class="hero"><div class="glow one"></div><div class="glow two"></div><div class="hero-copy"><span class="eyebrow">✨ Islamic digital store owned by Sunni Brothers</span><h1>Modern, low-price, quality Islamic caps for every believer.</h1><p>Shop prayer caps, embroidered topis, kids caps, and retailer packs with online ordering, dynamic QR payment, live order tracking, and personal support.</p><div class="hero-actions"><a href="#products" class="btn primary">Shop caps →</a><a href="#share" class="btn ghost">🔗 Store link</a><a href="${CONTACT.youtube}" class="btn ghost" target="_blank">▶ 120K+ YouTube</a></div></div><div class="hero-card"><div class="dome">﷽</div><h2>BBK Premium Topi</h2><p>Soft cotton • Clean stitching • Bulk available</p><div class="price">from ₹79</div><div class="card-row">✅ Verified quality ›</div></div></section>`}
function stats(){return`<section class="stats">${[['▶','120K+','YouTube Family'],['₹','₹79','Starting From'],['🏬','Bulk','Retail Ready'],['🛡','24/7','Secure Orders']].map(s=>`<div class="stat">${icon(s[0])}<strong>${s[1]}</strong><span>${s[2]}</span></div>`).join('')}</section>`}

function shareLink(){let url=location.href.split('#')[0],whatsapp=`https://wa.me/?text=${encodeURIComponent('Shop BBK Caps online: '+url)}`;return`<section id="share" class="section share-box"><div><span class="eyebrow">🔗 Shareable store link</span><h2>Create and share the BBK Caps link</h2><p>Copy this website link or share it directly on WhatsApp with customers, retailers, friends, and YouTube viewers.</p></div><div class="link-card"><input id="storeLink" readonly value="${url}"><button id="copyLink">Copy link</button><a class="btn ghost" href="${whatsapp}" target="_blank">Share on WhatsApp</a><small id="copyStatus">Ready to share BBK Caps online.</small></div></section>`}
function productSection(){return`<section id="products" class="section"><div class="section-title"><span>Shop Online</span><h2>Featured Islamic Caps</h2></div><div class="product-grid">${products.map(p=>`<article class="product"><div class="badge">${p.badge}</div><div class="product-art">${p.image}</div><h3>${p.name}</h3><p>${p.description}</p><div class="meta"><span>${p.category}</span><span>${p.color}</span></div><div class="buy"><strong>₹${p.price}</strong><button data-add="${p.id}">🛍 Add</button></div></article>`).join('')}</div></section>`}
function checkout(){let t=total(),upi=`upi://pay?pa=${CONTACT.upi}&pn=BBK%20Caps&am=${t||1}&cu=INR&tn=BBK%20Caps%20Order`,qr=`https://api.qrserver.com/v1/create-qr-code/?size=190x190&data=${encodeURIComponent(upi)}`;return`<section class="section checkout"><div><h2>Your Cart & Dynamic QR Payment</h2><div class="cart">${cart.length?cart.map(i=>`<div><span>${i.name} × ${i.qty}</span><b>₹${i.price*i.qty}</b></div>`).join(''):'<p>No caps added yet.</p>'}<h3>Total: ₹${t}</h3></div>${t?`<div class="qr"><img src="${qr}" alt="Dynamic UPI QR for ₹${t}"><p>Scan to pay ₹${t}. Add UPI reference while placing order.</p></div>`:''}</div><form id="orderForm"><input required name="name" placeholder="Full name"><input required name="phone" placeholder="Mobile number"><textarea required name="address" placeholder="Delivery address"></textarea><input name="paymentRef" placeholder="UPI/payment reference"><button class="btn primary">Place order</button></form></section>`}
function tracking(){return`<section id="track" class="section split"><div><span class="eyebrow">🚚 Order tracking</span><h2>Track your BBK Caps order</h2><p>Enter your Track ID or mobile number to see the latest status.</p><div class="search">🔎<input id="trackInput" placeholder="BBK-123456-789 or phone"></div></div><div class="panel" id="trackResult"><p>Order status will appear here.</p></div></section>`}
function retailer(){return`<section id="retailer" class="section retailer"><h2>Connect as retailer</h2><p>Need bulk caps for your shop, madrasa, masjid event, or Eid counter? Contact BBK Caps for wholesale pricing.</p><div class="contact-cards"><a href="tel:${CONTACT.phone}">☎ ${CONTACT.phone}</a><a href="mailto:${CONTACT.email}">✉ ${CONTACT.email}</a><a href="https://wa.me/91${CONTACT.phone}" target="_blank">💬 WhatsApp Retail</a></div></section>`}
function reviewSection(){return`<section id="reviews" class="section"><div class="section-title"><span>Customer voices</span><h2>Share Reviews</h2></div><div class="review-grid">${reviews.map(r=>`<div class="review"><span class="stars">${'★'.repeat(r.rating)}${'☆'.repeat(5-r.rating)}</span><p>“${r.text}”</p><b>${r.name}</b></div>`).join('')}</div><form class="review-form" id="reviewForm"><input required name="name" placeholder="Your name"><select name="rating"><option>5</option><option>4</option><option>3</option></select><input required name="text" placeholder="Write review"><button>Add review</button></form></section>`}
function admin(){return`<section id="admin" class="section admin"><div class="section-title"><span>Islamic dashboard</span><h2>Admin Panel</h2></div><div class="admin-grid"><form id="productForm" class="panel"><h3>＋ Add product</h3>${['name','price','stock','category','color','description'].map(k=>`<input required name="${k}" placeholder="${k}">`).join('')}<button>Add cap</button></form><div class="panel"><h3>📋 Manage orders</h3>${orders.length?orders.map(o=>`<div class="order"><b>${o.id}</b><span>${o.name} • ₹${o.total}</span><select data-status="${o.id}">${['Payment verification','Confirmed','Packed','Shipped','Delivered'].map(s=>`<option ${o.status===s?'selected':''}>${s}</option>`).join('')}</select></div>`).join(''):'<p>No orders yet.</p>'}</div><div class="panel"><h3>📦 Inventory</h3>${products.map(p=>`<div class="order"><span>${p.name}</span><b>${p.stock} pcs</b><button data-del="${p.id}">🗑</button></div>`).join('')}</div></div></section>`}
function bind(){document.querySelector('#menu').onclick=()=>document.querySelector('#links').classList.toggle('open');document.querySelector('#copyLink')?.addEventListener('click',async()=>{let input=document.querySelector('#storeLink'),status=document.querySelector('#copyStatus');try{await navigator.clipboard.writeText(input.value);status.textContent='Store link copied successfully.'}catch{input.select();document.execCommand('copy');status.textContent='Store link copied.'}});document.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>{let p=products.find(x=>x.id===b.dataset.add),i=cart.find(x=>x.id===p.id);i?i.qty++:cart.push({...p,qty:1});render()});document.querySelector('#orderForm').onsubmit=e=>{e.preventDefault();if(!cart.length)return alert('Please add caps to cart first.');let data=Object.fromEntries(new FormData(e.target));let o={...data,id:id(),items:cart,total:total(),status:'Payment verification',date:new Date().toLocaleString()};orders=[o,...orders];save('bbk-orders',orders);cart=[];alert(`Order placed! Track ID: ${o.id}`);render()};document.querySelector('#trackInput').oninput=e=>{let q=e.target.value.toLowerCase(),o=orders.find(x=>x.id.toLowerCase()===q||x.phone===q);document.querySelector('#trackResult').innerHTML=o?`<h3>${o.id}</h3><p>Status: <b>${o.status}</b></p><p>Total: ₹${o.total}</p><small>${o.date}</small>`:'<p>Order status will appear here.</p>'};document.querySelector('#reviewForm').onsubmit=e=>{e.preventDefault();reviews=[Object.fromEntries(new FormData(e.target)),...reviews];reviews[0].rating=Number(reviews[0].rating);save('bbk-reviews',reviews);render()};document.querySelector('#productForm').onsubmit=e=>{e.preventDefault();let p=Object.fromEntries(new FormData(e.target));products=[{...p,id:'bbk-'+Date.now(),price:Number(p.price),stock:Number(p.stock),badge:'Admin Added',image:'🧢'},...products];save('bbk-products',products);render()};document.querySelectorAll('[data-status]').forEach(s=>s.onchange=()=>{orders=orders.map(o=>o.id===s.dataset.status?{...o,status:s.value}:o);save('bbk-orders',orders)});document.querySelectorAll('[data-del]').forEach(b=>b.onclick=()=>{products=products.filter(p=>p.id!==b.dataset.del);save('bbk-products',products);render()})}
render();

    </script>
  </body>
</html>
